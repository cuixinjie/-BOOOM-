[gd_scene load_steps=3 format=3 uid="uid://shop_ui"]

[ext_resource type="Script" path="res://scripts/ui/ShopUI.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/UIComponents/InventorySlot.gd" id="2"]

## ShopUI 场景 - 商店界面
[node name="ShopUI" type="CanvasLayer"]
script = ExtResource("1")

## 商店主面板
[node name="ShopPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ShopPanel"]
layout_mode = 2
theme_override_constants/separation = 16

## 顶部标题栏
[node name="Header" type="HBoxContainer" parent="ShopPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="ShopPanel/VBox/Header"]
layout_mode = 2
text = "商店"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="ShopPanel/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CoinDisplay" type="HBoxContainer" parent="ShopPanel/VBox/Header"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CoinIcon" type="TextureRect" parent="ShopPanel/VBox/Header/CoinDisplay"]
layout_mode = 2
size_override = Vector2i(24, 24)

[node name="CoinLabel" type="Label" parent="ShopPanel/VBox/Header/CoinDisplay"]
layout_mode = 2
text = "0"

[node name="CloseButton" type="Button" parent="ShopPanel/VBox/Header"]
layout_mode = 2
text = "关闭"

## 分类标签页
[node name="CategoryTabs" type="HBoxContainer" parent="ShopPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WeaponsTab" type="Button" parent="ShopPanel/VBox/CategoryTabs"]
layout_mode = 2
text = "武器"

[node name="AmmoTab" type="Button" parent="ShopPanel/VBox/CategoryTabs"]
layout_mode = 2
text = "弹药"

[node name="UpgradesTab" type="Button" parent="ShopPanel/VBox/CategoryTabs"]
layout_mode = 2
text = "升级"

[node name="ItemsTab" type="Button" parent="ShopPanel/VBox/CategoryTabs"]
layout_mode = 2
text = "道具"

[node name="TabSpacer" type="Control" parent="ShopPanel/VBox/CategoryTabs"]
layout_mode = 2
size_flags_horizontal = 3

## 商品网格
[node name="Content" type="ScrollContainer" parent="ShopPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ItemGrid" type="GridContainer" parent="ShopPanel/VBox/Content"]
layout_mode = 2
size_flags_horizontal = 3
columns = 4
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

## 商品格子 0-3
[node name="ItemSlot0" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot1" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot2" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot3" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

## 商品格子 4-7
[node name="ItemSlot4" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot5" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot6" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot7" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

## 商品格子 8-11
[node name="ItemSlot8" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot9" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot10" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ItemSlot11" type="Control" parent="ShopPanel/VBox/Content/ItemGrid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

## 消息标签
[node name="MessageLabel" type="Label" parent="ShopPanel/VBox"]
layout_mode = 2
text = ""
horizontal_alignment = 1

## 购买确认面板
[node name="ConfirmPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -100.0
offset_right = 150.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ConfirmPanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ItemName" type="Label" parent="ConfirmPanel/VBox"]
layout_mode = 2
text = "物品名称"
horizontal_alignment = 1

[node name="ItemPrice" type="Label" parent="ConfirmPanel/VBox"]
layout_mode = 2
text = "价格: 0 金币"
horizontal_alignment = 1

[node name="BuyButton" type="Button" parent="ConfirmPanel/VBox"]
layout_mode = 2
text = "购买"

[node name="CancelButton" type="Button" parent="ConfirmPanel/VBox"]
layout_mode = 2
text = "取消"

[connection signal="pressed" from="ShopPanel/VBox/Header/CloseButton" to="ShopUI" method="_on_close_pressed"]
[connection signal="pressed" from="ShopPanel/VBox/CategoryTabs/WeaponsTab" to="ShopUI" method="_on_category_weapons"]
[connection signal="pressed" from="ShopPanel/VBox/CategoryTabs/AmmoTab" to="ShopUI" method="_on_category_ammo"]
[connection signal="pressed" from="ShopPanel/VBox/CategoryTabs/UpgradesTab" to="ShopUI" method="_on_category_upgrades"]
[connection signal="pressed" from="ShopPanel/VBox/CategoryTabs/ItemsTab" to="ShopUI" method="_on_category_items"]
[connection signal="pressed" from="ConfirmPanel/VBox/BuyButton" to="ShopUI" method="_on_buy_confirmed"]
[connection signal="pressed" from="ConfirmPanel/VBox/CancelButton" to="ShopUI" method="_on_buy_canceled"]
