; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MADMEN"
config/description="双人合作弹幕射击游戏"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
InputManager="*res://scripts/autoload/InputManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
ConfigMgr="*res://scripts/autoload/ConfigManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
WorldStateManager="*res://scripts/autoload/WorldStateManager.gd"
ObjectPool="*res://scripts/core/ObjectPool.gd"
DamageSystem="*res://scripts/core/DamageSystem.gd"
EconomySystem="*res://scripts/systems/economy/EconomySystem.gd"
ShopSystem="*res://scripts/systems/economy/ShopSystem.gd"
SpawnSystem="*res://scripts/systems/level/SpawnSystem.gd"
SegmentGenerator="*res://scripts/systems/level/SegmentGenerator.gd"
SpecialSegmentManager="*res://scripts/systems/special/SpecialSegmentManager.gd"
RestPointManager="*res://scripts/systems/level/RestPointManager.gd"
BulletFactory="*res://scripts/entities/bullet/BulletFactory.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="MADMEN"

